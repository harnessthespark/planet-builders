{
  "expo": {
    "name": "Planet Builders",
    "slug": "planet-builders",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planetbuilders.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a2e"
      },
      "package": "com.planetbuilders.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}